# ─────────────────────────────────────────────────────────────────────────────
#  Copy to `.env.local` for local development, and set the same names in your
#  hosting provider's dashboard (Vercel → Project → Settings → Environment).
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (baked into the browser bundle — never put secrets here) ─────────

# The live domain, with no trailing slash. Enables canonical URLs, absolute
# Open Graph image links, sitemap.xml and the Sitemap line in robots.txt.
# On Vercel this falls back to the project's production domain automatically.
VITE_SITE_URL=

# Where the enquiry forms POST to. Leave EMPTY until enquiries are connected:
# the forms will then say plainly that messages are not yet being delivered,
# instead of pretending to succeed.
# To use the bundled Vercel function set it to: /api/enquiry
VITE_ENQUIRY_ENDPOINT=

# Show content placeholders ("pending" markers) in a production build, e.g.
# for a review deployment with the building management. Always on in dev.
VITE_SHOW_PLACEHOLDERS=false

# ── Server-only (used by api/enquiry.ts; never exposed to the browser) ──────

# Resend (https://resend.com) API key used to deliver enquiry emails.
RESEND_API_KEY=

# Verified sender, e.g. "Hodo Souk Website <enquiries@your-domain>"
ENQUIRY_FROM=

# Office and residential enquiries go to separate inboxes so the two are
# never mixed together. Comma-separate multiple recipients.
ENQUIRY_TO_OFFICE=
ENQUIRY_TO_RESIDENTIAL=
